---
import BreathingCube from './BreathingCube.astro';

/**
 * Real Menu.png start screen with the static cube masked
 * and a live CSS 3D cube composited at the measured cube center.
 */
---

<div class="relative h-full">
  <img
    src="/images/menu.png"
    alt="Return start screen"
    width="828"
    height="1792"
    class="phone-shot"
    fetchpriority="high"
  />
  <div class="menu-cube-mask" aria-hidden="true"></div>
  <div class="menu-cube-overlay" aria-hidden="true">
    <BreathingCube class="breathing-cube--hero" />
  </div>
</div>
