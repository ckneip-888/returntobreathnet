---
import BreathingCube from './BreathingCube.astro';

/**
 * Faithful recreation of the Return start screen (Menu.png),
 * with the static cube replaced by a live CSS 3D cube.
 */
---

<div class="relative h-full flex flex-col text-white select-none">
  <header class="flex items-center justify-between px-5 pt-5 pb-2">
    <span class="text-[17px] font-semibold tracking-tight">Return</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="1.6" aria-hidden="true">
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6" stroke-linecap="round" />
    </svg>
  </header>

  <div class="relative flex-1 flex items-center justify-center min-h-0">
    <!-- Navy patch covers the static cube region; live cube is composited on top -->
    <div class="cube-slot w-[58%] aspect-square max-w-[200px]"></div>
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
      <BreathingCube size={148} />
    </div>
  </div>

  <div class="px-5 pb-5 space-y-3">
    <div class="w-full rounded-full bg-signal text-white text-[13px] font-semibold tracking-[0.18em] uppercase py-3.5 text-center">
      Start
    </div>
    <div class="grid grid-cols-2 gap-2">
      <div class="rounded-lg bg-panel px-3 py-2.5">
        <div class="flex items-center gap-1.5 text-gray-400 mb-1">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" stroke-linecap="round" />
          </svg>
          <span class="text-[9px] tracking-wide">Duration</span>
        </div>
        <div class="text-[13px] font-medium text-white">5 min.</div>
      </div>
      <div class="rounded-lg bg-panel px-3 py-2.5">
        <div class="flex items-center gap-1.5 text-gray-400 mb-1">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M3 12c2-4 4-4 6 0s4 4 6 0 4-4 6 0" stroke-linecap="round" />
          </svg>
          <span class="text-[9px] tracking-wide">Pattern</span>
        </div>
        <div class="text-[12px] font-medium text-white leading-tight">Coherence: 5.5-5.5</div>
      </div>
      <div class="rounded-lg bg-panel px-3 py-2.5">
        <div class="flex items-center gap-1.5 text-gray-400 mb-1">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 10v4h3l4 3V7L7 10H4zM16 9a4 4 0 0 1 0 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="text-[9px] tracking-wide">Sound</span>
        </div>
        <div class="text-[13px] font-medium text-white">Soft Pad</div>
      </div>
      <div class="rounded-lg bg-panel px-3 py-2.5">
        <div class="flex items-center gap-1.5 text-gray-400 mb-1">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="8" y="4" width="8" height="16" rx="1.6" /><path d="M4 9v6M20 9v6" stroke-linecap="round" />
          </svg>
          <span class="text-[9px] tracking-wide">Vibration</span>
        </div>
        <div class="text-[13px] font-medium text-white">On</div>
      </div>
    </div>
  </div>
</div>
