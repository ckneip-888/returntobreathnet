---
import BreathingCube from './BreathingCube.astro';
import { copy, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);
---

<div class="relative h-full flex flex-col text-white select-none">
  <header class="flex items-center justify-between px-5 pt-5">
    <span class="text-[13px] font-medium text-gray-400 tabular-nums">{t.how.sessionTime}</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.8" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </header>

  <div class="flex-1 flex flex-col items-center justify-center min-h-0 pb-6">
    <BreathingCube size={168} />
    <p class="mt-8 text-[22px] font-light tracking-tight">{t.how.sessionPhase}</p>
    <p class="mt-1.5 text-[13px] text-gray-400">{t.how.sessionCycle}</p>
  </div>

  <div class="flex justify-center pb-8">
    <div class="w-11 h-11 rounded-full bg-signal flex items-center justify-center">
      <svg width="12" height="14" viewBox="0 0 12 14" fill="#fff" aria-hidden="true">
        <rect x="1" y="1" width="3.2" height="12" rx="0.6" />
        <rect x="7.8" y="1" width="3.2" height="12" rx="0.6" />
      </svg>
    </div>
  </div>
</div>
