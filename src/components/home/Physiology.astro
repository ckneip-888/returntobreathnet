---
import { copy, type Lang } from '../../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);
const visuals = ['hrv', 'shield', 'vagus'] as const;
---

<section id="physiology" class="py-20 lg:py-28 border-t border-gray-800/80">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="max-w-2xl mb-14">
      <p class="micro-label-accent mb-4">{t.physiology.eyebrow}</p>
      <h2 class="text-3xl lg:text-4xl font-light tracking-tight text-white leading-tight">
        {t.physiology.headline}
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-8">
      {t.physiology.cards.map((card, i) => (
        <article class="flex flex-col">
          <div class="mb-6 h-36 flex items-center justify-center rounded-md border border-gray-800 bg-black/40">
            {visuals[i] === 'hrv' && (
              <svg viewBox="0 0 280 120" class="w-[90%] h-auto" aria-hidden="true">
                <text
                  x="70"
                  y="22"
                  text-anchor="middle"
                  fill="#9CA3AF"
                  font-size="10"
                  font-family="IBM Plex Mono, monospace"
                  letter-spacing="1.6"
                >STRESS</text>
                <text
                  x="210"
                  y="22"
                  text-anchor="middle"
                  fill="#f87171"
                  font-size="10"
                  font-family="IBM Plex Mono, monospace"
                  letter-spacing="1.6"
                >COHERENCE</text>
                <path
                  d="M18 72 L32 48 L46 94 L60 50 L74 92 L88 52 L102 90 L116 54 L130 72"
                  fill="none"
                  stroke="#6b7280"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />
                <path
                  d="M150 72 C164 48, 178 48, 192 72 S 220 96, 234 72 S 248 48, 262 72"
                  fill="none"
                  stroke="#DC2626"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>
            )}
            {visuals[i] === 'shield' && (
              <svg viewBox="0 0 200 130" class="w-[78%] h-auto" aria-hidden="true">
                <path
                  d="M78 20 L124 38 V68 C124 92 102 108 78 116 C54 108 32 92 32 68 V38 Z"
                  fill="rgba(220,38,38,0.12)"
                  stroke="#DC2626"
                  stroke-width="1.5"
                />
                <g fill="none" stroke="#9CA3AF" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="188,20 122,46 150,12" />
                  <polyline points="196,64 124,66 162,92" />
                  <polyline points="184,114 120,84 154,120" />
                </g>
                <polygon points="150,12 141,16 147,24" fill="#9CA3AF" />
                <polygon points="162,92 152,86 155,98" fill="#9CA3AF" />
                <polygon points="154,120 145,112 160,114" fill="#9CA3AF" />
              </svg>
            )}
            {visuals[i] === 'vagus' && (
              <svg viewBox="0 0 160 140" class="w-[58%] h-auto" aria-hidden="true">
                <!-- Head, neck, shoulders -->
                <ellipse cx="80" cy="28" rx="17" ry="19" fill="none" stroke="#6b7280" stroke-width="1.3" />
                <path
                  d="M71 46 C71 50, 72 54, 72 58"
                  fill="none"
                  stroke="#6b7280"
                  stroke-width="1.3"
                  stroke-linecap="round"
                />
                <path
                  d="M89 46 C89 50, 88 54, 88 58"
                  fill="none"
                  stroke="#6b7280"
                  stroke-width="1.3"
                  stroke-linecap="round"
                />
                <path
                  d="M72 58 C52 60, 34 68, 30 86 L30 118 L130 118 L130 86 C126 68, 108 60, 88 58"
                  fill="none"
                  stroke="#6b7280"
                  stroke-width="1.3"
                  stroke-linejoin="round"
                />
                <!-- Vagus bundle through the neck into the chest -->
                <path d="M80 46 C80 46, 80 92, 80 112" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" />
                <path d="M75 50 C74 72, 70 94, 68 114" fill="none" stroke="#f87171" stroke-width="1.2" opacity="0.75" />
                <path d="M85 50 C86 72, 90 94, 92 114" fill="none" stroke="#f87171" stroke-width="1.2" opacity="0.75" />
                <path d="M78 48 C77 78, 76 96, 76 112" fill="none" stroke="#DC2626" stroke-width="1" opacity="0.45" />
                <path d="M82 48 C83 78, 84 96, 84 112" fill="none" stroke="#DC2626" stroke-width="1" opacity="0.45" />
              </svg>
            )}
          </div>
          <h3 class="text-xl font-light tracking-tight text-white mb-3">{card.title}</h3>
          <p class="text-[15px] text-gray-400 leading-relaxed font-light mb-4">{card.body}</p>
          <p class="text-[13px] text-gray-200 font-light mb-3">{card.counter}</p>
          <p class="micro-label mb-5">{card.source}</p>
          <a href="#download" class="mt-auto text-[13px] text-signal hover:text-sapphire-400 transition-colors">
            {card.cta} →
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
