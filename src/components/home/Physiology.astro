---
import { copy, type Lang } from '../../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);
const visuals = ['hrv', 'shield', 'vagus'] as const;

/** Chevron at `tip`, pointing away from `from`. Base sits on the shaft centerline. */
function chevron(tipX: number, tipY: number, fromX: number, fromY: number, size = 8.5) {
  const dx = tipX - fromX;
  const dy = tipY - fromY;
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  const bx = tipX - ux * size;
  const by = tipY - uy * size;
  const px = -uy * size * 0.55;
  const py = ux * size * 0.55;
  return {
    points: `${tipX},${tipY} ${bx + px},${by + py} ${bx - px},${by - py}`,
    baseX: bx,
    baseY: by,
  };
}

const shieldArrows = [
  { from: [186, 22], hit: [122, 46], tip: [152, 16] },
  { from: [192, 64], hit: [126, 66], tip: [164, 90] },
  { from: [180, 112], hit: [122, 86], tip: [156, 116] },
].map((a) => ({
  ...a,
  head: chevron(a.tip[0], a.tip[1], a.hit[0], a.hit[1]),
}));
---

<section id="physiology" class="py-20 lg:py-28 border-t border-gray-800/80">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="max-w-2xl mb-14">
      <p class="micro-label-accent mb-4">{t.physiology.eyebrow}</p>
      <h2 class="text-3xl lg:text-4xl font-light tracking-tight text-white leading-tight">
        {t.physiology.headline}
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-8">
      {t.physiology.cards.map((card, i) => (
        <article class="flex flex-col">
          <div class="mb-6 h-36 flex items-center justify-center rounded-md border border-gray-800 bg-black/40">
            {visuals[i] === 'hrv' && (
              <svg viewBox="0 0 280 120" class="w-[90%] h-auto" aria-hidden="true">
                <text
                  x="70"
                  y="22"
                  text-anchor="middle"
                  fill="#9CA3AF"
                  font-size="10"
                  font-family="IBM Plex Mono, monospace"
                  letter-spacing="1.6"
                >STRESS</text>
                <text
                  x="210"
                  y="22"
                  text-anchor="middle"
                  fill="#f87171"
                  font-size="10"
                  font-family="IBM Plex Mono, monospace"
                  letter-spacing="1.6"
                >COHERENCE</text>
                <path
                  d="M18 72 L32 48 L46 94 L60 50 L74 92 L88 52 L102 90 L116 54 L130 72"
                  fill="none"
                  stroke="#6b7280"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />
                <path
                  d="M150 72 C164 48, 178 48, 192 72 S 220 96, 234 72 S 248 48, 262 72"
                  fill="none"
                  stroke="#DC2626"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>
            )}
            {visuals[i] === 'shield' && (
              <svg viewBox="0 0 200 130" class="w-[78%] h-auto" aria-hidden="true">
                <path
                  d="M72 22 L118 40 V70 C118 92 96 108 72 114 C48 108 26 92 26 70 V40 Z"
                  fill="rgba(220,38,38,0.12)"
                  stroke="#DC2626"
                  stroke-width="1.5"
                />
                {shieldArrows.map((arrow) => (
                  <g>
                    <polyline
                      points={`${arrow.from[0]},${arrow.from[1]} ${arrow.hit[0]},${arrow.hit[1]} ${arrow.head.baseX},${arrow.head.baseY}`}
                      fill="none"
                      stroke="#9CA3AF"
                      stroke-width="1.45"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <polygon points={arrow.head.points} fill="#9CA3AF" />
                  </g>
                ))}
              </svg>
            )}
            {visuals[i] === 'vagus' && (
              <svg viewBox="0 0 160 160" class="h-[70%] w-auto" aria-hidden="true">
                <!-- Schematic bust, crown left open -->
                <path
                  d="M70 28 C64 28, 56 34, 56 44 C56 58, 104 58, 104 44 C104 34, 96 28, 90 28"
                  fill="none"
                  stroke="#9CA3AF"
                  stroke-width="1.4"
                  stroke-linecap="round"
                />
                <path
                  d="M74 58 L74 70 M86 58 L86 70"
                  fill="none"
                  stroke="#9CA3AF"
                  stroke-width="1.4"
                  stroke-linecap="round"
                />
                <path
                  d="M40 74 C40 68, 66 70, 74 70 L86 70 C94 70, 120 68, 120 74"
                  fill="none"
                  stroke="#9CA3AF"
                  stroke-width="1.4"
                  stroke-linecap="round"
                />
                <path d="M80 56 C80 56, 80 100, 80 132" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round" />
                <path d="M75 60 C74 86, 70 110, 68 134" fill="none" stroke="#f87171" stroke-width="1.2" opacity="0.75" />
                <path d="M85 60 C86 86, 90 110, 92 134" fill="none" stroke="#f87171" stroke-width="1.2" opacity="0.75" />
                <path d="M78 58 C77 90, 76 112, 76 132" fill="none" stroke="#DC2626" stroke-width="1" opacity="0.45" />
                <path d="M82 58 C83 90, 84 112, 84 132" fill="none" stroke="#DC2626" stroke-width="1" opacity="0.45" />
              </svg>
            )}
          </div>
          <h3 class="text-xl font-light tracking-tight text-white mb-3">{card.title}</h3>
          <p class="text-[15px] text-gray-400 leading-relaxed font-light mb-4">{card.body}</p>
          <p class="text-[13px] text-gray-200 font-light mb-3">{card.counter}</p>
          <p class="micro-label mb-5">{card.source}</p>
          <a href="#download" class="mt-auto text-[13px] text-signal hover:text-sapphire-400 transition-colors">
            {card.cta} →
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
