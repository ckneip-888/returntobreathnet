---
import { copy, type Lang } from '../../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);
const visuals = ['hrv', 'shield', 'vagus'] as const;
---

<section id="physiology" class="py-20 lg:py-28 border-t border-gray-800/80">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="max-w-2xl mb-14">
      <p class="micro-label-accent mb-4">{t.physiology.eyebrow}</p>
      <h2 class="text-3xl lg:text-4xl font-light tracking-tight text-white leading-tight">
        {t.physiology.headline}
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-8">
      {t.physiology.cards.map((card, i) => (
        <article class="flex flex-col">
          <div class="mb-6 h-36 flex items-center justify-center rounded-md border border-gray-800 bg-black/40">
            {visuals[i] === 'hrv' && (
              <svg viewBox="0 0 280 110" class="w-[88%] h-auto" aria-hidden="true">
                <text x="8" y="16" fill="#6b7280" font-size="9" font-family="IBM Plex Mono, monospace" letter-spacing="1.4">STRESS</text>
                <text x="168" y="16" fill="#f87171" font-size="9" font-family="IBM Plex Mono, monospace" letter-spacing="1.4">COHERENCE</text>
                <path d="M8 48 l8 4 6-8 7 12 6-14 7 10 6-6 8 8 7-4 8 6" fill="none" stroke="#4b5563" stroke-width="1.4" />
                <path d="M150 70 C 168 18, 186 18, 204 70 S 240 122, 258 70" fill="none" stroke="#DC2626" stroke-width="1.6" />
              </svg>
            )}
            {visuals[i] === 'shield' && (
              <svg viewBox="0 0 200 120" class="w-[70%] h-auto" aria-hidden="true">
                <path d="M100 18 L148 36 V70 C148 92 126 108 100 114 C74 108 52 92 52 70 V36 Z" fill="rgba(220,38,38,0.12)" stroke="#DC2626" stroke-width="1.4" />
                <path d="M168 22 L138 48" stroke="#9CA3AF" stroke-width="1.2" />
                <path d="M178 46 L140 62" stroke="#9CA3AF" stroke-width="1.2" />
                <path d="M170 72 L142 74" stroke="#6b7280" stroke-width="1.2" stroke-dasharray="3 3" />
                <polygon points="138,48 144,46 142,52" fill="#9CA3AF" />
                <polygon points="140,62 146,61 143,67" fill="#9CA3AF" />
              </svg>
            )}
            {visuals[i] === 'vagus' && (
              <svg viewBox="0 0 180 120" class="w-[62%] h-auto" aria-hidden="true">
                <path d="M90 8 C 118 18, 128 40, 126 58 C 148 78, 146 110, 128 118 L52 118 C34 110, 32 78, 54 58 C52 40, 62 18, 90 8 Z" fill="none" stroke="#4b5563" stroke-width="1.2" />
                <path d="M90 22 C 90 22, 90 96, 90 108" stroke="#DC2626" stroke-width="2" stroke-linecap="round" />
                <path d="M82 28 C 82 28, 80 96, 78 110" stroke="#f87171" stroke-width="1.2" opacity="0.7" />
                <path d="M98 28 C 98 28, 100 96, 102 110" stroke="#f87171" stroke-width="1.2" opacity="0.7" />
                <path d="M86 26 C 86 26, 85 94, 84 108" stroke="#DC2626" stroke-width="1" opacity="0.45" />
                <path d="M94 26 C 94 26, 95 94, 96 108" stroke="#DC2626" stroke-width="1" opacity="0.45" />
              </svg>
            )}
          </div>
          <h3 class="text-xl font-light tracking-tight text-white mb-3">{card.title}</h3>
          <p class="text-[15px] text-gray-400 leading-relaxed font-light mb-4">{card.body}</p>
          <p class="text-[13px] text-gray-200 font-light mb-3">{card.counter}</p>
          <p class="micro-label mb-5">{card.source}</p>
          <a href="#download" class="mt-auto text-[13px] text-signal hover:text-sapphire-400 transition-colors">
            {card.cta} →
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
