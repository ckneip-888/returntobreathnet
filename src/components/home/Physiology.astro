---
import { copy, type Lang } from '../../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);
---

<section class="py-20 lg:py-28 border-t border-gray-800/80">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="max-w-2xl mb-14">
      <p class="micro-label-accent mb-4">{t.physiology.eyebrow}</p>
      <h2 class="text-3xl lg:text-4xl font-light tracking-tight text-white leading-tight mb-5">
        {t.physiology.headline}
      </h2>
      <p class="text-[16px] text-gray-400 leading-relaxed font-light">
        {t.physiology.intro}
      </p>
    </div>

    <div class="mb-14">
      <svg viewBox="0 0 960 220" class="w-full h-auto" role="img" aria-hidden="true">
        <path d="M40 150 C 120 150, 160 70, 240 70 S 360 150, 440 150 S 560 70, 640 70 S 760 150, 920 150" fill="none" stroke="#374151" stroke-width="1.25" />
        <path d="M40 150 C 120 150, 160 70, 240 70 S 360 150, 440 150 S 560 70, 640 70 S 760 150, 920 150" fill="none" stroke="#DC2626" stroke-width="1.25" stroke-opacity="0.55" />
        <circle cx="240" cy="70" r="3.5" fill="#DC2626" />
        <circle cx="440" cy="150" r="3.5" fill="#9CA3AF" />
        <circle cx="640" cy="70" r="3.5" fill="#DC2626" />
        <text x="240" y="48" text-anchor="middle" fill="#F87171" font-size="10" font-family="IBM Plex Mono, monospace" letter-spacing="2">RR</text>
        <text x="440" y="178" text-anchor="middle" fill="#9CA3AF" font-size="10" font-family="IBM Plex Mono, monospace" letter-spacing="2">RSA</text>
        <text x="640" y="48" text-anchor="middle" fill="#F87171" font-size="10" font-family="IBM Plex Mono, monospace" letter-spacing="2">HRV</text>
      </svg>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8">
      {t.physiology.terms.map((term) => (
        <div>
          <dt class="text-[13px] font-medium text-white mb-2">{term.name}</dt>
          <dd class="text-[13px] text-gray-400 font-light leading-relaxed">{term.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
