---
import ProtocolWaveform from '../ProtocolWaveform.astro';
import SpiralMark from '../SpiralMark.astro';
import { copy, type Lang } from '../../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);
---

<section id="protocol" class="relative py-20 lg:py-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="relative mb-12">
      <div
        class="pointer-events-none absolute right-0 -top-8 z-0 w-[min(12rem,40vw)] opacity-[0.17] select-none"
        aria-hidden="true"
      >
        <SpiralMark variant="field" />
      </div>
      <div class="relative z-[1] max-w-2xl">
        <p class="micro-label-gold mb-4">{t.protocol.eyebrow}</p>
        <h2 class="text-3xl lg:text-4xl font-light tracking-tight text-white leading-tight mb-5">
          {t.protocol.headline}
        </h2>
        <p class="text-[16px] text-gray-400 leading-relaxed font-light">
          {t.protocol.body}
        </p>
      </div>
    </div>

    <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-12">
      {t.protocol.cards.map((card) => (
        <article class="rounded-md bg-panel border border-gray-700/80 p-5">
          <h3 class="text-[15px] font-medium text-white mb-1">{card.name}</h3>
          <p class="font-mono text-[11px] text-signal tracking-wide mb-3">{card.ratio}</p>
          <p class="text-[13px] text-gray-400 font-light leading-relaxed">{card.use}</p>
        </article>
      ))}
    </div>

    <div class="mb-10 max-w-4xl">
      <ProtocolWaveform lang={lang} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {t.protocol.guides.map((guide) => (
        <article class="rounded-md border border-gray-800 bg-black/30 p-6 flex flex-col">
          <h3 class="text-[17px] font-medium tracking-tight text-white mb-2">{guide.title}</h3>
          <p class="text-[14px] text-gray-400 font-light leading-relaxed mb-5 flex-1">{guide.body}</p>
          <a href={guide.href} class="text-[13px] text-signal hover:text-sapphire-400 transition-colors">
            {guide.cta} →
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
