---
import { copy, type Lang } from '../../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);
const href = lang === 'de' ? '/de/writing/' : '/writing/';
const breathlineHref = lang === 'de' ? '/de/breathline/' : '/breathline/';
---

<section class="py-12 border-t border-gray-800/80">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3">
      <div>
        <p class="micro-label-accent mb-2">{t.fieldNotes.label}</p>
        <p class="text-[14px] text-gray-500 font-light">{t.fieldNotes.blurb}</p>
      </div>
      <a href={href} data-track="field_notes_click" class="text-[13px] text-signal hover:text-sapphire-400 transition-colors shrink-0">
        {t.fieldNotes.link} →
      </a>
    </div>

    <div class="hairline my-10"></div>

    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3">
      <div>
        <p class="micro-label-accent mb-2">{t.breathline.teaserTitle}</p>
        <p class="text-[14px] text-gray-500 font-light max-w-xl">{t.breathline.teaserLead}</p>
      </div>
      <a href={breathlineHref} data-track="Start_the_exercise_click" class="text-[13px] text-signal hover:text-sapphire-400 transition-colors shrink-0">
        {t.breathline.teaserCta} →
      </a>
    </div>
  </div>
</section>
