---
import PhoneFrame from '../PhoneFrame.astro';
import SessionScreen from '../SessionScreen.astro';
import { copy, type Lang } from '../../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);
---

<section class="py-20 lg:py-28 border-t border-gray-800/80">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_300px] gap-14 lg:gap-20 items-center">
      <div>
        <p class="micro-label-accent mb-4">{t.how.eyebrow}</p>
        <h2 class="text-3xl lg:text-4xl font-light tracking-tight text-white leading-tight mb-12">
          {t.how.headline}
        </h2>
        <ol class="space-y-8">
          {t.how.steps.map((step) => (
            <li class="flex gap-5">
              <span class="micro-label-accent pt-1 shrink-0 w-8">{step.n}</span>
              <div>
                <h3 class="text-[17px] font-medium text-white mb-1">{step.title}</h3>
                <p class="text-[15px] text-gray-400 font-light leading-relaxed">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="flex justify-center lg:justify-end">
        <PhoneFrame label="Return breathing session">
          <SessionScreen lang={lang} />
        </PhoneFrame>
      </div>
    </div>
  </div>
</section>
