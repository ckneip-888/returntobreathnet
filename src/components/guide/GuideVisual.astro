---
export interface Props {
  kind:
    | 'ripple'
    | 'paths'
    | 'breathline'
    | 'practice'
    | 'doorway'
    | 'standing-wave'
    | 'pendulums'
    | 'chest'
    | 'body-wave'
    | 'sunrise'
    | 'timer';
}

const { kind } = Astro.props;
const teal = '#2A9D8F';
---

<figure class="guide-visual mb-10 rounded-md border border-gray-800 bg-black/40 overflow-hidden" aria-hidden="true">
  {kind === 'ripple' && (
    <svg viewBox="0 0 800 280" class="w-full h-auto">
      <circle cx="400" cy="140" r="18" fill="none" stroke={teal} stroke-width="1.2" opacity="0.95" />
      <circle cx="400" cy="140" r="48" fill="none" stroke={teal} stroke-width="1" opacity="0.55" class="guide-ripple" />
      <circle cx="400" cy="140" r="88" fill="none" stroke={teal} stroke-width="1" opacity="0.35" class="guide-ripple guide-ripple--2" />
      <circle cx="400" cy="140" r="132" fill="none" stroke={teal} stroke-width="0.8" opacity="0.22" class="guide-ripple guide-ripple--3" />
      <circle cx="400" cy="140" r="176" fill="none" stroke={teal} stroke-width="0.7" opacity="0.12" />
    </svg>
  )}

  {kind === 'paths' && (
    <svg viewBox="0 0 800 220" class="w-full h-auto">
      <path d="M40 40 C 220 40, 480 110, 720 110" fill="none" stroke={teal} stroke-width="1.4" class="guide-flow" />
      <path d="M40 110 C 240 110, 480 110, 720 110" fill="none" stroke={teal} stroke-width="1.4" opacity="0.7" class="guide-flow" />
      <path d="M40 180 C 220 180, 480 110, 720 110" fill="none" stroke={teal} stroke-width="1.4" opacity="0.45" class="guide-flow" />
      <circle cx="720" cy="110" r="14" fill="none" stroke={teal} stroke-width="1.6" />
      <circle cx="720" cy="110" r="4" fill={teal} />
    </svg>
  )}

  {kind === 'breathline' && (
    <svg viewBox="0 0 800 240" class="w-full h-auto">
      <path d="M40 120 C 140 120, 200 40, 300 40 C 400 40, 400 200, 500 200 C 600 200, 660 120, 760 120" fill="none" stroke={teal} stroke-width="1.6" />
      <circle cx="300" cy="40" r="8" fill="none" stroke="#DC2626" stroke-width="1.6" />
      <circle cx="500" cy="200" r="8" fill="none" stroke="#DC2626" stroke-width="1.6" />
      <text x="300" y="22" text-anchor="middle" fill="#9CA3AF" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">STILLNESS</text>
      <text x="500" y="228" text-anchor="middle" fill="#9CA3AF" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">STILLNESS</text>
      <text x="120" y="108" fill="#6b7280" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">MOTION</text>
      <text x="640" y="108" fill="#6b7280" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">MOTION</text>
    </svg>
  )}

  {kind === 'practice' && (
    <svg viewBox="0 0 800 260" class="w-full h-auto">
      <ellipse cx="400" cy="58" rx="22" ry="24" fill="none" stroke="#9CA3AF" stroke-width="1.3" />
      <path d="M400 82 L400 128 M400 128 L360 210 M400 128 L440 210 M400 108 L320 150 M400 108 L480 150" fill="none" stroke="#9CA3AF" stroke-width="1.3" stroke-linecap="round" />
      <ellipse cx="400" cy="118" rx="70" ry="28" fill="none" stroke={teal} stroke-width="1.2" opacity="0.85" />
      <circle cx="330" cy="118" r="5" fill="none" stroke="#DC2626" stroke-width="1.5" />
      <circle cx="470" cy="118" r="5" fill="none" stroke="#DC2626" stroke-width="1.5" />
    </svg>
  )}

  {kind === 'doorway' && (
    <svg viewBox="0 0 800 260" class="w-full h-auto">
      <path d="M280 230 L280 70 Q400 18 520 70 L520 230" fill="none" stroke={teal} stroke-width="1.4" />
      <path d="M80 80 C 110 120, 90 140, 130 170 C 70 190, 140 200, 90 230" fill="none" stroke="#4b5563" stroke-width="1.1" />
      <path d="M150 70 C 180 90, 120 130, 170 160 C 130 190, 190 210, 140 240" fill="none" stroke="#374151" stroke-width="1" />
      <path d="M200 90 C 230 140, 180 170, 220 220" fill="none" stroke="#4b5563" stroke-width="1" />
      <path d="M620 130 C 660 130, 700 130, 740 130" fill="none" stroke={teal} stroke-width="1.6" />
      <circle cx="680" cy="130" r="3.5" fill={teal} class="guide-pulse" />
      <text x="400" y="252" text-anchor="middle" fill="#9CA3AF" font-size="12" font-family="IBM Plex Mono, monospace" letter-spacing="2.2">THE THRESHOLD IS YOUR BREATH</text>
    </svg>
  )}

  {kind === 'standing-wave' && (
    <svg viewBox="0 0 800 280" class="w-full h-auto">
      <path d="M40 140 C 120 60, 200 60, 280 140 S 440 220, 520 140 S 680 60, 760 140" fill="none" stroke="#374151" stroke-width="1.1" />
      <path d="M40 140 C 120 220, 200 220, 280 140 S 440 60, 520 140 S 680 220, 760 140" fill="none" stroke="#4b5563" stroke-width="1.1" />
      <path d="M40 140 L 120 80 L 200 200 L 280 80 L 360 200 L 440 80 L 520 200 L 600 80 L 680 200 L 760 140" fill="none" stroke={teal} stroke-width="1.8" />
    </svg>
  )}

  {kind === 'pendulums' && (
    <svg viewBox="0 0 800 240" class="w-full h-auto">
      <line x1="80" y1="36" x2="720" y2="36" stroke="#374151" stroke-width="1.2" />
      <g class="guide-pendulum guide-pendulum--1" style="transform-origin: 220px 36px">
        <line x1="220" y1="36" x2="220" y2="170" stroke={teal} stroke-width="1.2" />
        <circle cx="220" cy="178" r="10" fill="none" stroke={teal} stroke-width="1.4" />
      </g>
      <g class="guide-pendulum" style="transform-origin: 400px 36px">
        <line x1="400" y1="36" x2="400" y2="170" stroke={teal} stroke-width="1.2" />
        <circle cx="400" cy="178" r="10" fill="none" stroke={teal} stroke-width="1.4" />
      </g>
      <g class="guide-pendulum guide-pendulum--3" style="transform-origin: 580px 36px">
        <line x1="580" y1="36" x2="580" y2="170" stroke={teal} stroke-width="1.2" />
        <circle cx="580" cy="178" r="10" fill="none" stroke={teal} stroke-width="1.4" />
      </g>
      <text x="400" y="226" text-anchor="middle" fill="#9CA3AF" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">ENTRAINMENT = PHYSICS</text>
    </svg>
  )}

  {kind === 'chest' && (
    <svg viewBox="0 0 800 260" class="w-full h-auto">
      <path d="M400 36 C 430 36, 452 58, 452 82 C 452 102, 438 116, 424 122 L 430 210 C 430 230, 370 230, 370 210 L 376 122 C 362 116, 348 102, 348 82 C 348 58, 370 36, 400 36 Z" fill="none" stroke="#9CA3AF" stroke-width="1.25" />
      <ellipse cx="400" cy="118" rx="28" ry="22" fill="rgba(42,157,143,0.12)" stroke={teal} stroke-width="1.3" class="guide-pulse" />
    </svg>
  )}

  {kind === 'body-wave' && (
    <svg viewBox="0 0 800 280" class="w-full h-auto">
      <ellipse cx="400" cy="48" rx="20" ry="22" fill="none" stroke="#9CA3AF" stroke-width="1.2" />
      <path d="M400 70 L400 112 M400 112 L358 200 M400 112 L442 200 M400 92 L330 132 M400 92 L470 132" fill="none" stroke="#9CA3AF" stroke-width="1.2" stroke-linecap="round" />
      <path d="M360 108 C 380 92, 420 92, 440 108 C 420 124, 380 124, 360 108" fill="none" stroke={teal} stroke-width="1.5" />
      <path d="M368 108 C 384 100, 416 100, 432 108" fill="none" stroke={teal} stroke-width="1" opacity="0.5" />
    </svg>
  )}

  {kind === 'sunrise' && (
    <svg viewBox="0 0 800 240" class="w-full h-auto">
      <line x1="80" y1="150" x2="720" y2="150" stroke="#374151" stroke-width="1" />
      <circle cx="400" cy="150" r="56" fill="none" stroke={teal} stroke-width="1.4" />
      <rect x="0" y="150" width="800" height="90" fill="#000814" />
      <path d="M80 200 C 160 170, 240 220, 320 190 S 480 160, 560 200 S 680 170, 720 190" fill="none" stroke={teal} stroke-width="1.3" />
      <text x="400" y="228" text-anchor="middle" fill="#9CA3AF" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2.4">SET YOUR BASELINE</text>
    </svg>
  )}

  {kind === 'timer' && (
    <svg viewBox="0 0 800 200" class="w-full h-auto">
      <text x="220" y="108" text-anchor="middle" fill="#e5e7eb" font-size="42" font-family="IBM Plex Mono, monospace">5–11</text>
      <text x="220" y="138" text-anchor="middle" fill="#9CA3AF" font-size="12" font-family="IBM Plex Mono, monospace" letter-spacing="2.4">MINUTES</text>
      <path d="M360 100 C 420 70, 480 130, 540 100 S 660 70, 720 100" fill="none" stroke={teal} stroke-width="1.5" class="guide-flow" />
    </svg>
  )}
</figure>

<style>
  .guide-ripple {
    transform-origin: 400px 140px;
    animation: guide-expand 6s ease-out infinite;
  }
  .guide-ripple--2 { animation-delay: 1.4s; }
  .guide-ripple--3 { animation-delay: 2.8s; }

  .guide-flow {
    stroke-dasharray: 8 10;
    animation: guide-dash 18s linear infinite;
  }

  .guide-pulse {
    transform-origin: center;
    animation: guide-pulse 3.6s ease-in-out infinite;
  }

  .guide-pendulum { animation: guide-swing 3.2s ease-in-out infinite; }
  .guide-pendulum--1 { animation-delay: -0.4s; }
  .guide-pendulum--3 { animation-delay: -0.2s; }

  @keyframes guide-expand {
    from { transform: scale(0.72); opacity: 0.55; }
    to { transform: scale(1.12); opacity: 0; }
  }
  @keyframes guide-dash {
    to { stroke-dashoffset: -240; }
  }
  @keyframes guide-pulse {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
  }
  @keyframes guide-swing {
    0%, 100% { transform: rotate(-9deg); }
    50% { transform: rotate(9deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-ripple,
    .guide-flow,
    .guide-pulse,
    .guide-pendulum { animation: none; }
  }
</style>
