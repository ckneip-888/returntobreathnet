  {kind === 'timer' && (
    <svg viewBox="0 0 800 200" class="w-full h-auto">
      <text x="220" y="108" text-anchor="middle" fill="#e5e7eb" font-size="42" font-family="IBM Plex Mono, monospace">5–11</text>
      <text x="220" y="138" text-anchor="middle" fill="#9CA3AF" font-size="12" font-family="IBM Plex Mono, monospace" letter-spacing="2.4">MINUTES</text>
      <path
        d="M352 100 C368.5 88.48, 385 78, 401.5 78 C418 78, 434.5 88.48, 451 100 C467.5 111.52, 484 122, 500.5 122 C517 122, 533.5 111.52, 550 100 C566.5 88.48, 583 78, 599.5 78 C616 78, 632.5 88.48, 649 100 C665.5 111.52, 682 122, 698.5 122 C715 122, 731.5 111.52, 748 100"
        fill="none"
        stroke={teal}
        stroke-width="1.5"
        stroke-linecap="round"
        class="guide-flow"
      />
    </svg>
  )}
</figure>

<style>
  .guide-ripple-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: guide-ripple-expand 6.4s cubic-bezier(0.15, 0.55, 0.35, 1) infinite;
  }
  .guide-ripple-ring--2 { animation-delay: 1.15s; }
  .guide-ripple-ring--3 { animation-delay: 2.3s; }
  .guide-ripple-ring--4 { animation-delay: 3.45s; }
  .guide-ripple-ring--5 { animation-delay: 4.6s; }

  .guide-ripple-core {
    transform-box: fill-box;
    transform-origin: center;
    animation: guide-ripple-core 6.4s ease-out infinite;
  }

  .guide-flow {
    stroke-dasharray: 8 10;
    animation: guide-dash 18s linear infinite;
  }

  .guide-pulse {
    transform-origin: center;
    animation: guide-pulse 3.6s ease-in-out infinite;
  }

  .guide-pendulum {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation-duration: 22.4s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .guide-pendulum--1 { animation-name: guide-pendulum-lead; }
  .guide-pendulum--2 { animation-name: guide-pendulum-mid; }
  .guide-pendulum--3 { animation-name: guide-pendulum-right; }

  @keyframes guide-ripple-expand {
    0% { transform: scale(0.07); opacity: 0.95; }
    18% { opacity: 0.55; }
    100% { transform: scale(1); opacity: 0; }
  }
  @keyframes guide-ripple-core {
    0%, 12% { transform: scale(0.7); opacity: 0.35; }
    18% { transform: scale(1.35); opacity: 0.8; }
    42% { transform: scale(1.9); opacity: 0; }
    100% { transform: scale(1.9); opacity: 0; }
  }
  @keyframes guide-dash {
    to { stroke-dashoffset: -240; }
  }
  @keyframes guide-pulse {
    0%, 100% { opacity: 0.7; }
    50% { opacity: 1; }
