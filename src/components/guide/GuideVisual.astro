        stroke={teal}
        stroke-width="1.35"
        stroke-linecap="round"
      />
      <text x="400" y="228" text-anchor="middle" fill="#9CA3AF" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2.4">SET YOUR BASELINE</text>
