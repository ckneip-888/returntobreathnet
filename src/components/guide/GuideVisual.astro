  {kind === 'sunrise' && (
    <svg viewBox="0 0 800 240" class="w-full h-auto">
      <defs>
        <clipPath id="gv-sunrise-sky">
          <rect x="0" y="0" width="800" height="118" />
        </clipPath>
        <radialGradient id="gv-sunrise-glow" cx="50%" cy="100%" r="70%">
          <stop offset="0%" stop-color={teal} stop-opacity="0.22" />
          <stop offset="100%" stop-color={teal} stop-opacity="0" />
        </radialGradient>
      </defs>
      <ellipse cx="400" cy="118" rx="90" ry="48" fill="url(#gv-sunrise-glow)" clip-path="url(#gv-sunrise-sky)" />
      <circle cx="400" cy="118" r="52" fill="none" stroke={teal} stroke-width="1.4" clip-path="url(#gv-sunrise-sky)" />
