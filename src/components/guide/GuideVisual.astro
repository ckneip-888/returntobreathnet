---
export interface Props {
  kind:
    | 'ripple'
    | 'paths'
    | 'breathline'
    | 'practice'
    | 'doorway'
    | 'standing-wave'
    | 'pendulums'
    | 'chest'
    | 'body-wave'
    | 'sunrise'
    | 'timer';
}

const { kind } = Astro.props;
const teal = '#2A9D8F';
---

<figure class="guide-visual mb-10 rounded-md border border-gray-800 bg-black/40 overflow-hidden" aria-hidden="true">
  {kind === 'ripple' && (
    <svg viewBox="0 0 800 300" class="w-full h-auto">
      <defs>
        <radialGradient id="gv-ripple-glow" cx="50%" cy="58%" r="52%">
          <stop offset="0%" stop-color={teal} stop-opacity="0.28" />
          <stop offset="32%" stop-color={teal} stop-opacity="0.1" />
          <stop offset="100%" stop-color={teal} stop-opacity="0" />
        </radialGradient>
        <radialGradient id="gv-ripple-core" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#5EEAD4" stop-opacity="0.7" />
          <stop offset="55%" stop-color={teal} stop-opacity="0.25" />
          <stop offset="100%" stop-color={teal} stop-opacity="0" />
        </radialGradient>
        <linearGradient id="gv-ripple-stroke" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#99F6E4" stop-opacity="0.15" />
          <stop offset="42%" stop-color="#5EEAD4" stop-opacity="0.95" />
          <stop offset="100%" stop-color={teal} stop-opacity="0.2" />
        </linearGradient>
      </defs>

      <ellipse cx="400" cy="176" rx="360" ry="98" fill="url(#gv-ripple-glow)" />

      <g fill="none" stroke={teal} stroke-width="0.55" opacity="0.18">
        <ellipse cx="400" cy="176" rx="330" ry="88" />
        <ellipse cx="400" cy="176" rx="250" ry="66" />
        <ellipse cx="400" cy="176" rx="170" ry="45" />
      </g>

      <g class="guide-ripple-ring" fill="none" stroke="url(#gv-ripple-stroke)" stroke-width="1.35">
        <ellipse cx="400" cy="176" rx="320" ry="86" />
      </g>
      <g class="guide-ripple-ring guide-ripple-ring--2" fill="none" stroke="url(#gv-ripple-stroke)" stroke-width="1.2">
        <ellipse cx="400" cy="176" rx="320" ry="86" />
      </g>
      <g class="guide-ripple-ring guide-ripple-ring--3" fill="none" stroke="url(#gv-ripple-stroke)" stroke-width="1.05">
        <ellipse cx="400" cy="176" rx="320" ry="86" />
      </g>
      <g class="guide-ripple-ring guide-ripple-ring--4" fill="none" stroke="url(#gv-ripple-stroke)" stroke-width="0.9">
        <ellipse cx="400" cy="176" rx="320" ry="86" />
      </g>
      <g class="guide-ripple-ring guide-ripple-ring--5" fill="none" stroke="url(#gv-ripple-stroke)" stroke-width="0.75">
        <ellipse cx="400" cy="176" rx="320" ry="86" />
      </g>

      <ellipse cx="400" cy="176" rx="28" ry="10" fill="url(#gv-ripple-core)" class="guide-ripple-core" />
      <ellipse cx="400" cy="176" rx="8" ry="3.1" fill={teal} opacity="0.9" />
      <ellipse cx="400" cy="176" rx="3.2" ry="1.3" fill="#99F6E4" opacity="0.85" />
    </svg>
  )}

  {kind === 'paths' && (
    <svg viewBox="0 0 800 220" class="w-full h-auto">
      <path d="M40 40 C 220 40, 480 110, 720 110" fill="none" stroke={teal} stroke-width="1.4" class="guide-flow" />
      <path d="M40 110 C 240 110, 480 110, 720 110" fill="none" stroke={teal} stroke-width="1.4" opacity="0.7" class="guide-flow" />
      <path d="M40 180 C 220 180, 480 110, 720 110" fill="none" stroke={teal} stroke-width="1.4" opacity="0.45" class="guide-flow" />
      <circle cx="720" cy="110" r="14" fill="none" stroke={teal} stroke-width="1.6" />
      <circle cx="720" cy="110" r="4" fill={teal} />
    </svg>
  )}

  {kind === 'breathline' && (
    <svg viewBox="0 0 800 240" class="w-full h-auto">
      <path d="M40 120 C 140 120, 200 40, 300 40 C 400 40, 400 200, 500 200 C 600 200, 660 120, 760 120" fill="none" stroke={teal} stroke-width="1.6" />
      <circle cx="300" cy="40" r="8" fill="none" stroke="#DC2626" stroke-width="1.6" />
      <circle cx="500" cy="200" r="8" fill="none" stroke="#DC2626" stroke-width="1.6" />
      <text x="300" y="22" text-anchor="middle" fill="#9CA3AF" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">STILLNESS</text>
      <text x="500" y="228" text-anchor="middle" fill="#9CA3AF" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">STILLNESS</text>
      <text x="120" y="108" fill="#6b7280" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">MOTION</text>
      <text x="640" y="108" fill="#6b7280" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">MOTION</text>
    </svg>
  )}

  {kind === 'practice' && (
    <svg viewBox="0 0 800 260" class="w-full h-auto">
      <ellipse cx="400" cy="58" rx="22" ry="24" fill="none" stroke="#9CA3AF" stroke-width="1.3" />
      <path d="M400 82 L400 128 M400 128 L360 210 M400 128 L440 210 M400 108 L320 150 M400 108 L480 150" fill="none" stroke="#9CA3AF" stroke-width="1.3" stroke-linecap="round" />
      <ellipse cx="400" cy="118" rx="70" ry="28" fill="none" stroke={teal} stroke-width="1.2" opacity="0.85" />
      <circle cx="330" cy="118" r="5" fill="none" stroke="#DC2626" stroke-width="1.5" />
      <circle cx="470" cy="118" r="5" fill="none" stroke="#DC2626" stroke-width="1.5" />
    </svg>
  )}

  {kind === 'doorway' && (
    <svg viewBox="0 0 800 260" class="w-full h-auto">
      <path d="M280 230 L280 70 Q400 18 520 70 L520 230" fill="none" stroke={teal} stroke-width="1.4" />
      <path d="M80 80 C 110 120, 90 140, 130 170 C 70 190, 140 200, 90 230" fill="none" stroke="#4b5563" stroke-width="1.1" />
      <path d="M150 70 C 180 90, 120 130, 170 160 C 130 190, 190 210, 140 240" fill="none" stroke="#374151" stroke-width="1" />
      <path d="M200 90 C 230 140, 180 170, 220 220" fill="none" stroke="#4b5563" stroke-width="1" />
      <path d="M620 130 C 660 130, 700 130, 740 130" fill="none" stroke={teal} stroke-width="1.6" />
      <circle cx="680" cy="130" r="3.5" fill={teal} class="guide-pulse" />
      <text x="400" y="252" text-anchor="middle" fill="#9CA3AF" font-size="12" font-family="IBM Plex Mono, monospace" letter-spacing="2.2">THE THRESHOLD IS YOUR BREATH</text>
    </svg>
  )}

  {kind === 'standing-wave' && (
    <svg viewBox="0 0 800 280" class="w-full h-auto">
      <path d="M40 140 C 120 60, 200 60, 280 140 S 440 220, 520 140 S 680 60, 760 140" fill="none" stroke={teal} stroke-width="1.35" opacity="0.95" />
      <path d="M40 140 C 120 220, 200 220, 280 140 S 440 60, 520 140 S 680 220, 760 140" fill="none" stroke={teal} stroke-width="1.35" opacity="0.5" />
    </svg>
  )}

  {kind === 'pendulums' && (
    <svg viewBox="0 0 800 240" class="w-full h-auto">
      <line x1="80" y1="36" x2="720" y2="36" stroke="#374151" stroke-width="1.2" />
      <circle cx="220" cy="36" r="2.4" fill={teal} />
      <circle cx="400" cy="36" r="2.4" fill={teal} />
      <circle cx="580" cy="36" r="2.4" fill={teal} />
      <g class="guide-pendulum guide-pendulum--1">
        <line x1="220" y1="36" x2="220" y2="168" stroke={teal} stroke-width="1.9" stroke-linecap="round" />
        <circle cx="220" cy="178" r="12" fill="none" stroke={teal} stroke-width="1.7" />
      </g>
      <g class="guide-pendulum guide-pendulum--2">
        <line x1="400" y1="36" x2="400" y2="168" stroke={teal} stroke-width="1.35" stroke-linecap="round" />
        <circle cx="400" cy="178" r="9.4" fill="none" stroke={teal} stroke-width="1.35" />
      </g>
      <g class="guide-pendulum guide-pendulum--3">
        <line x1="580" y1="36" x2="580" y2="168" stroke={teal} stroke-width="0.85" stroke-linecap="round" />
        <circle cx="580" cy="178" r="7" fill="none" stroke={teal} stroke-width="1.05" />
      </g>
      <text x="400" y="226" text-anchor="middle" fill="#9CA3AF" font-size="11" font-family="IBM Plex Mono, monospace" letter-spacing="2">ENTRAINMENT = PHYSICS</text>
    </svg>
  )}

  {kind === 'chest' && (
    <svg viewBox="0 0 800 260" class="w-full h-auto">
      <path d="M400 36 C 430 36, 452 58, 452 82 C 452 102, 438 116, 424 122 L 430 210 C 430 230, 370 230, 370 210 L 376 122 C 362 116, 348 102, 348 82 C 348 58, 370 36, 400 36 Z" fill="none" stroke="#9CA3AF" stroke-width="1.25" />
      <ellipse cx="400" cy="118" rx="28" ry="22" fill="rgba(42,157,143,0.12)" stroke={teal} stroke-width="1.3" class="guide-pulse" />
    </svg>
