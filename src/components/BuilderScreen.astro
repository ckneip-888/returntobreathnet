---
import { copy, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);

const presets = t.protocol.cards;
---

<div class="h-full overflow-y-auto text-white select-none px-3.5 py-4">
  <header class="flex items-center justify-between px-1.5 pb-4">
    <span class="text-[16px] font-semibold text-gray-400">Return</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="1.6" aria-hidden="true">
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6" stroke-linecap="round" />
    </svg>
  </header>

  <div class="space-y-1.5 mb-4">
    {presets.map((card) => (
      <div class="rounded-lg bg-panel px-3.5 py-2.5">
        <div class="text-[13px] font-semibold">{card.name}: {card.short}</div>
        <div class="text-[10px] text-gray-400 mt-0.5 font-mono tracking-wide">{card.detail}</div>
      </div>
    ))}
  </div>

  <div class="rounded-lg border border-signal/80 p-3.5 space-y-3">
    <div class="flex items-center gap-2 text-[13px] font-medium">
      <span class="text-signal text-base leading-none">+</span>
      <span>{t.builder.create}</span>
    </div>
    <p class="text-[10px] text-gray-400 italic leading-relaxed">{t.builder.hint}</p>
    <div class="grid grid-cols-2 gap-2">
      <label class="block">
        <span class="text-[9px] text-gray-400">{t.builder.inhale}</span>
        <div class="mt-1 rounded-md bg-navy-deep/60 border border-gray-700 px-2 py-2 text-[16px] font-medium">6</div>
      </label>
      <label class="block">
        <span class="text-[9px] text-gray-400">{t.builder.topHold}</span>
        <div class="mt-1 rounded-md bg-navy-deep/60 border border-gray-700 px-2 py-2 text-[16px] font-medium">6</div>
      </label>
      <label class="block">
        <span class="text-[9px] text-gray-400">{t.builder.exhale}</span>
        <div class="mt-1 rounded-md bg-navy-deep/60 border border-gray-700 px-2 py-2 text-[16px] font-medium">6</div>
      </label>
      <label class="block">
        <span class="text-[9px] text-gray-400">{t.builder.bottomHold}</span>
        <div class="mt-1 rounded-md bg-navy-deep/60 border border-gray-700 px-2 py-2 text-[16px] font-medium">6</div>
      </label>
    </div>
    <div class="flex items-center gap-2 pt-1">
      <div class="flex-1 rounded-full border border-signal text-signal text-[12px] font-medium py-2 text-center">{t.builder.save}</div>
      <div class="flex-1 rounded-full bg-signal text-white text-[12px] font-semibold py-2 text-center">{t.builder.use}</div>
    </div>
  </div>
</div>
