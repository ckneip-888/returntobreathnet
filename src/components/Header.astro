---
import BrandMark from './BrandMark.astro';
import { copy, type Lang } from '../i18n';
import { otherLangHref } from '../i18n/path';

export interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = copy(lang);

const homeHref = lang === 'de' ? '/de/' : '/';
const writingHref = lang === 'de' ? '/de/writing/' : '/writing/';
const aboutHref = lang === 'de' ? '/de/about/' : '/about/';
const protocolHref = `${homeHref}#protocol`;
const enHref = otherLangHref(currentPath, 'en');
const deHref = otherLangHref(currentPath, 'de');

const isWriting = currentPath.includes('/writing');
const isAbout = currentPath.includes('/about');
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-gray-800/80 bg-navy/80 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-6 lg:px-12 h-16 flex items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-2.5 group shrink-0" aria-label={t.brand.homeAria}>
      <BrandMark size={28} />
      <span class="text-[24px] font-medium tracking-tight leading-none text-white group-hover:text-gray-200 transition-colors">
        {t.brand.name}
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-7" aria-label="Primary">
      <a href={protocolHref} class="text-[13px] text-gray-400 hover:text-white transition-colors">{t.nav.protocol}</a>
      <a
        href={writingHref}
        data-track="field_notes_click"
        class={`text-[13px] transition-colors ${isWriting ? 'text-white' : 'text-gray-400 hover:text-white'}`}
        aria-current={isWriting ? 'page' : undefined}
      >
        {t.nav.fieldNotes}
      </a>
      <a
        href={aboutHref}
        data-track="about_click"
        class={`text-[13px] transition-colors ${isAbout ? 'text-white' : 'text-gray-400 hover:text-white'}`}
        aria-current={isAbout ? 'page' : undefined}
      >
        {t.nav.about}
      </a>
      <div class="flex items-center gap-1 text-[11px] font-mono tracking-wider" role="group" aria-label={t.nav.language}>
        <a
          href={enHref}
          class={`px-1.5 py-1 ${lang === 'en' ? 'text-white' : 'text-gray-500 hover:text-gray-300'} transition-colors`}
          aria-current={lang === 'en' ? 'page' : undefined}
        >
          EN
        </a>
        <span class="text-gray-700">/</span>
        <a
          href={deHref}
          class={`px-1.5 py-1 ${lang === 'de' ? 'text-white' : 'text-gray-500 hover:text-gray-300'} transition-colors`}
          aria-current={lang === 'de' ? 'page' : undefined}
        >
          DE
        </a>
      </div>
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer text-gray-300 hover:text-white p-2 -mr-2" aria-label={t.nav.menu}>
        <span class="sr-only">{t.nav.menu}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 top-12 w-56 rounded-md border border-gray-800 bg-navy p-4 shadow-2xl space-y-3">
        <a href={protocolHref} class="block text-[14px] text-gray-300 hover:text-white">{t.nav.protocol}</a>
        <a href={writingHref} data-track="field_notes_click" class="block text-[14px] text-gray-300 hover:text-white">{t.nav.fieldNotes}</a>
        <a href={aboutHref} data-track="about_click" class="block text-[14px] text-gray-300 hover:text-white">{t.nav.about}</a>
        <div class="pt-2 border-t border-gray-800 flex items-center gap-1 text-[11px] font-mono tracking-wider">
          <a href={enHref} class={lang === 'en' ? 'text-white px-1.5 py-1' : 'text-gray-500 px-1.5 py-1'}>EN</a>
          <span class="text-gray-700">/</span>
          <a href={deHref} class={lang === 'de' ? 'text-white px-1.5 py-1' : 'text-gray-500 px-1.5 py-1'}>DE</a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] > summary svg { opacity: 0.6; }
</style>
