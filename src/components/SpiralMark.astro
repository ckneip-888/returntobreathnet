<svg
  viewBox="0 0 400 400"
  class:list={['spiral-mark', sizeClass, className]}
  fill="none"
  aria-hidden="true"
>
  <path
    d={spiralPath}
    stroke="currentColor"
    stroke-width={stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>

<style>
  .spiral-mark {
    color: #c9a96e;
    transform-box: view-box;
    transform-origin: 50% 50%;
    animation: spiral-turn 180s linear infinite;
  }

  @keyframes spiral-turn {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .spiral-mark { animation: none; }
  }
</style>
