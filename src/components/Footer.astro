---
import BrandMark from './BrandMark.astro';
import { copy, type Lang } from '../i18n';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
const basePath = lang === 'de' ? '/de' : '';
---

<footer class="bg-navy pt-16 pb-10 border-t border-gray-800/80">
  <div class="max-w-6xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-2.5 mb-4">
          <BrandMark size={24} />
          <span class="text-[15px] font-medium tracking-tight text-white">{t.brand.name}</span>
        </div>
        <p class="text-[14px] text-gray-500 leading-relaxed font-light max-w-md">
          {t.footer.blurb}
        </p>
      </div>

      <div class="md:col-span-2">
        <div class="micro-label-accent mb-4">{t.footer.site}</div>
        <ul class="space-y-2.5 text-[13px] text-gray-400 font-light">
          <li><a href={`${basePath}/about/`} class="hover:text-white transition-colors">{t.footer.about}</a></li>
          <li><a href={`${basePath}/writing/`} class="hover:text-white transition-colors">{t.footer.fieldNotes}</a></li>
          <li><a href={`${basePath}/terms/`} class="hover:text-white transition-colors">{t.footer.terms}</a></li>
          <li><a href={`${basePath}/privacy/`} class="hover:text-white transition-colors">{t.footer.privacy}</a></li>
          <li><a href={`${basePath}/impressum/`} class="hover:text-white transition-colors">{t.footer.impressum}</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <div class="micro-label-accent mb-4">{t.footer.elsewhere}</div>
        <ul class="space-y-2.5 text-[13px] text-gray-400 font-light">
          <li>
            <a href="https://www.youtube.com/@returnpulse" target="_blank" rel="noopener" class="hover:text-white inline-flex items-center gap-1.5 transition-colors">
              {t.footer.youtube}
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17 17 7M8 7h9v9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
          <li>
            <a href="#" aria-disabled="true" class="hover:text-white inline-flex items-center gap-1.5 transition-colors">
              {t.footer.appStore}
            </a>
          </li>
          <li>
            <a href="#" aria-disabled="true" class="hover:text-white inline-flex items-center gap-1.5 transition-colors">
              {t.footer.googlePlay}
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <div class="micro-label-accent mb-4">{t.footer.contact}</div>
        <ul class="space-y-2.5 text-[13px] text-gray-400 font-light">
          <li><a href="mailto:info@returnapp.org" class="hover:text-white transition-colors">info@returnapp.org</a></li>
          <li class="text-gray-600">Zürich, Switzerland</li>
        </ul>
      </div>
    </div>

    <div class="hairline mb-8"></div>

    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="seal text-gray-500">{t.footer.mark}</div>
      <div class="text-[11px] text-gray-600 font-light">{t.footer.copyright}</div>
    </div>
  </div>
</footer>
