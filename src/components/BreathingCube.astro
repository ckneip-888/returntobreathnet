---
export interface Props {
  size?: number;
  class?: string;
}

const { size, class: className = '' } = Astro.props;
---

<div
  class={`breathing-cube ${className}`.trim()}
  style={size ? `--cube-size: ${size}px` : undefined}
  aria-hidden="true"
>
  <div class="breathing-cube__rig">
    <div class="breathing-cube__face breathing-cube__face--front"></div>
    <div class="breathing-cube__face breathing-cube__face--back"></div>
    <div class="breathing-cube__face breathing-cube__face--right"></div>
    <div class="breathing-cube__face breathing-cube__face--left"></div>
    <div class="breathing-cube__face breathing-cube__face--top"></div>
    <div class="breathing-cube__face breathing-cube__face--bottom"></div>
  </div>
</div>
