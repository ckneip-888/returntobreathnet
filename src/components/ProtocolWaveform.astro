---
import { copy, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = copy(lang);

const phases = [
  { label: t.protocol.inhale, x: 130 },
  { label: t.protocol.hold, x: 310 },
  { label: t.protocol.exhale, x: 490 },
  { label: t.protocol.hold, x: 670 },
];

const wavePath = 'M40 150 C 90 150, 170 50, 220 50 L 400 50 C 450 50, 530 150, 580 150 L 760 150';
---

<figure class="w-full">
  <svg viewBox="0 0 800 210" class="w-full h-auto" role="img" aria-label={`${t.protocol.inhale} → ${t.protocol.hold} → ${t.protocol.exhale} → ${t.protocol.hold}`}>
    <path d={wavePath} fill="none" stroke="#374151" stroke-width="1.5" />
    <path d={wavePath} fill="none" stroke="#DC2626" stroke-width="1.5" stroke-opacity="0.85" />
    <circle r="4.5" fill="#DC2626" class="wave-tracer">
      <animateMotion dur="16s" repeatCount="indefinite" rotate="0" path={wavePath} />
    </circle>
    {phases.map((p) => (
      <text
        x={p.x}
        y="192"
        text-anchor="middle"
        fill="#9CA3AF"
        font-size="11"
        font-family="IBM Plex Mono, ui-monospace, monospace"
        letter-spacing="2.4"
      >
        {p.label.toUpperCase()}
      </text>
    ))}
  </svg>
</figure>
