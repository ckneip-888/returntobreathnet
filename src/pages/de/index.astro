---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Baseline from '../../components/home/Baseline.astro';
import CustomBuilder from '../../components/home/CustomBuilder.astro';
import Download from '../../components/home/Download.astro';
import FieldNotesTeaser from '../../components/home/FieldNotesTeaser.astro';
import Hero from '../../components/home/Hero.astro';
import HowItWorks from '../../components/home/HowItWorks.astro';
import Physiology from '../../components/home/Physiology.astro';
import Pitches from '../../components/home/Pitches.astro';
import Pricing from '../../components/home/Pricing.astro';
import Protocol from '../../components/home/Protocol.astro';
import { copy } from '../../i18n';

const t = copy('de');
---

