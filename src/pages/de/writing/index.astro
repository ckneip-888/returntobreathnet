---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { copy } from '../../../i18n';

const t = copy('de');
const PINNED_SLUGS = ['the-simplicity-problem'];

function bareId(id: string) {
  return id.replace(/^de\//, '');
}

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'de' && !data.draft);

const posts = allPosts.sort((a, b) => {
  const aIdx = PINNED_SLUGS.indexOf(bareId(a.id));
  const bIdx = PINNED_SLUGS.indexOf(bareId(b.id));
  const aIsPinned = aIdx !== -1;
  const bIsPinned = bIdx !== -1;

  if (aIsPinned && bIsPinned) return aIdx - bIdx;
  if (aIsPinned) return -1;
  if (bIsPinned) return 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
---

<BaseLayout
  title={t.writing.pageTitle}
  description={t.writing.description}
  lang="de"
>
  <section class="max-w-3xl mx-auto px-6 lg:px-8 pt-32 pb-24">
    <header class="mb-12">
      <div class="micro-label-accent mb-4">{t.writing.eyebrow}</div>
      <h1 class="text-4xl sm:text-5xl font-light tracking-tight text-white leading-tight mb-4">
        {t.writing.title}
      </h1>
      <p class="text-lg text-gray-400 leading-relaxed font-light max-w-2xl">
        {t.writing.intro}
      </p>
    </header>

    <div class="space-y-0">
      {posts.map((post) => (
        <ArticleCard
          href={`/de/writing/${bareId(post.id)}/`}
          title={post.data.title}
          description={post.data.description}
          tags={post.data.tags}
          lang="de"
          pinned={PINNED_SLUGS.includes(bareId(post.id))}
        />
      ))}
    </div>
  </section>
</BaseLayout>
